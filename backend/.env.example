FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_DATABASE_URL=your-firebase-database-url

API_PORT=8000
API_HOST=0.0.0.0

# Development only: true lets local demo tokens work.
ALLOW_CUSTOM_TOKEN_AUTH=true

# Development only: leave false unless you intentionally seed Firebase data.
SEED_FIREBASE_DATA=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=driver-documents

GEOAPIFY_API_KEY=00000000000000000000

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
